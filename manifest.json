{
  "manifest_version": 3,
  "name": "FEP Master Autofill Suite",
  "version": "1.0.0",
  "description": "Chrome extension for autofilling Lead, Proposal, and PO forms in FEP environments.",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "FEP Master Autofill Suite"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fep.freyrenergy.com/*",
        "https://uat-fep.freyrenergy.com/*",
        "https://qa-console.sunpro.tilicho.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
