{
  "manifest_version": 3,
  "name": "FEP Master Autofill Suite",
  "version": "1.0.4",
  "description": "Chrome extension for autofilling Lead, Proposal, and PO forms in FEP environments.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "FEP Master Autofill Suite"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://uat-fep.freyrenergy.com/*",
    "https://uat-api.sunpro.tilicho.in:444/*",
    "https://prod-api.sunpro.tilicho.in:444/*",
    "https://qa-fep-api.freyrenergy.com/*",
    "https://stg-fep-api.freyrenergy.com/*",
    "https://fep.freyrenergy.com/*",
    "https://qa-fep.freyrenergy.com/*",
    "https://stg-fep.freyrenergy.com/*",
    "https://uat-fep-api.freyrenergy.com/*",
    "https://fep-api.freyrenergy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://uat-fep.freyrenergy.com/login*",
        "https://fep.freyrenergy.com/login*",
        "https://qa-fep-api.freyrenergy.com/login*",
        "https://stg-fep-api.freyrenergy.com/login*",
        "https://qa-fep.freyrenergy.com/login*",
        "https://stg-fep.freyrenergy.com/login*"
      ],
      "js": [
        "interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://uat-fep.freyrenergy.com/login*",
        "https://fep.freyrenergy.com/login*",
        "https://qa-fep-api.freyrenergy.com/login*",
        "https://stg-fep-api.freyrenergy.com/login*",
        "https://qa-fep.freyrenergy.com/login*",
        "https://stg-fep.freyrenergy.com/login*"
      ],
      "js": [
        "otp-listener.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fep.freyrenergy.com/*",
        "https://uat-fep.freyrenergy.com/*",
        "https://qa-console.sunpro.tilicho.in/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "https://qa-fep-api.freyrenergy.com/*",
        "https://stg-fep-api.freyrenergy.com/*",
        "https://qa-fep.freyrenergy.com/*",
        "https://stg-fep.freyrenergy.com/*"
      ],
      "js": [
        "custom-tools.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
